    "jpeg_quality": 68,
    "frame_interval_seconds": 0.05,
    "log_dir": "runtime_logs",
    "auth_enabled": false,
    "auth_username": "YOUR_VIEWER_USER",
    "auth_password": "YOUR_VIEWER_PASSWORD"
  }
}
