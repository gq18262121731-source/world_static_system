# ============================================================
# 智慧康养健康监测系统（选拔赛 dev 版）—— 配置示例
#
# 用法：
#   Copy-Item .env.example .env
# 然后至少补齐 QWEN_API_KEY / DASHSCOPE_API_KEY 和 JWT_SECRET。
#
# 未在此列出的配置项一律使用 backend/config.py 中的默认值。
# ============================================================

# ---------------- 应用 ----------------
APP_NAME=AIoT智慧康养健康监测系统
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---------------- 存储 ----------------
# 建议保持注释。代码会基于仓库根目录生成绝对路径；
# 若在此填相对路径，从非仓库根目录启动会另建一份 app.db 和 chroma 库。
# 确需自定义时请填绝对路径。
# DATABASE_URL=sqlite+aiosqlite:///E:/absolute/path/to/data/app.db
# CHROMA_PATH=E:/absolute/path/to/data/chroma
REDIS_URL=redis://localhost:6379/0

# ---------------- 大模型 ----------------
# qwen=云端百炼，ollama=本地模型，auto=按密钥是否配齐自动选
LLM_PROVIDER=qwen
# 使用云端 Qwen 时设为 false；完全断网跑本地模型时设为 true
OFFLINE_ONLY_RUNTIME=false

QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-dashscope-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL=qwen3.5-flash
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_ASR_MODEL=qwen3-asr-flash-realtime-2026-02-10
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_OMNI_MODEL=qwen2.5-omni-7b
# 不设置时代码回退到 longyingtian
# QWEN_TTS_VOICE=longyingtian

QWEN_RERANK_MODEL=gte-rerank-v2
QWEN_RERANK_API=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
QWEN_ENABLE_RERANK=true

# 本地模型仅支持 qwen3:1.7b 与 deepseek-r1:1.5b，填其他值启动会直接校验失败
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

LLM_TIMEOUT_SECONDS=10
DIALOGUE_MAX_PREDICT_TOKENS=160
DIALOGUE_MAX_OUTPUT_CHARS=220

# ---------------- RAG ----------------
RAG_TIMEOUT_SECONDS=15
RAG_TOP_K=3
RAG_FETCH_K=8
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=150

# ---------------- 网络探测 ----------------
NETWORK_PROBE_URL=https://dashscope.aliyuncs.com
NETWORK_PROBE_TIMEOUT_SECONDS=3
NETWORK_PROBE_CACHE_SECONDS=20

# ---------------- 鉴权 ----------------
# 生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-random-64-hex-string
SEED_DEFAULT_ACCOUNTS=true
SEED_DEFAULT_PASSWORD=123456

# ---------------- 数据采集 ----------------
# 演示模式（无手环）：DATA_MODE=mock、USE_MOCK_DATA=true、SERIAL_ENABLED=false
# 真机模式（接 T10）：按下面这组，串口参数会被 backend/runtime_bootstrap.py
# 依据 shouhuan.py 的常量和端口自动探测结果覆盖，此处仅为兜底值。
DATA_MODE=serial
USE_MOCK_DATA=false
SERIAL_ENABLED=true
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
# 需与 shouhuan.py 的 HANDWARE_MAC 保持一致
SERIAL_MAC_FILTER=54:10:26:01:00:DF
SERIAL_PACKET_TYPE=5
SERIAL_APPLY_MAC_FILTER=false
SERIAL_APPLY_PACKET_TYPE=true
SERIAL_AUTO_CONFIGURE=true
SERIAL_DISABLE_UUID_OUTPUT=true
SERIAL_ENABLE_BROADCAST_SOS_OVERLAY=true
SERIAL_PACKET_MERGE_TIMEOUT_SECONDS=0.5
SERIAL_RESPONSE_CYCLE_SECONDS=1
SERIAL_BROADCAST_CYCLE_SECONDS=0.5
SERIAL_FALLBACK_DEVICE_MAC=

# ---------------- MQTT（网关模式，可选）----------------
# MQTT_ENABLED=false
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883
# MQTT_TOPIC=t10-gateway
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ---------------- 摄像头 / 视觉（默认全部关闭）----------------
# 接入网络摄像头做跌倒/姿态检测时再启用，完整参数见 backend/config.py。
# CAMERA_IP=192.168.x.x
# CAMERA_USER=admin
# CAMERA_PASSWORD=
# CAMERA_SOURCE_MODE=auto
# FALL_DETECTION_ENABLED=true
# POSE_DETECTION_ENABLED=true

# ---------------- 健康模型 ----------------
MODEL_DEVICE=auto
# 训练数据不在仓库内，放到别处时用这一项指过去
# STATIC_HEALTH_DATA_PATH=D:/code/health/data/raw/patients_data_with_alerts.xlsx
#
# ALLOW_RULE_ONLY_FALLBACK 必须保持 false。设为 true 并不会退化成纯规则评分，
# inference.py 会改抛 InferenceError，比缺产物本身的报错更难排查。
# 评分接口要能用，只能先训练出 data/artifacts/static_health/ 下的模型产物：
#   conda run -n helth python .\scripts\train_static_model.py

# ---------------- 外部检索（可选）----------------
TAVILY_API_KEY=
